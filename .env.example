# =============================================================================
# Hanako Bot - environment template
# Copy to .env (`make setup`) and fill in the values. Never commit .env.
# =============================================================================

# --- Discord (required) ------------------------------------------------------
# Bot token from https://discord.com/developers/applications
CLIENT_TOKEN=
# ID of the guild (server) where slash commands are registered
GUILD_ID=

# --- Discord (optional) ------------------------------------------------------
# Your Discord user ID, for owner-only commands
OWNER_ID=

# --- Database ----------------------------------------------------------------
# Used by the postgres container (docker-compose.yml). POSTGRES_PASSWORD is required.
POSTGRES_USER=hanako
POSTGRES_PASSWORD=
POSTGRES_DB=hanako

# Only for running outside Docker (npm run dev). docker-compose.yml builds it from
POSTGRES_*.
# DATABASE_URL=postgres://hanako:CHANGE_ME@localhost:5432/hanako

# --- Logging -----------------------------------------------------------------
# true enables debug logs
DEBUG=false

# --- Guild settings (optional fallbacks) -------------------------------------
# Normally edited from the /config panel and stored in the database.
# Resolution order: database > env > default. Leave unset to use the default.
# MODERATOR_ROLE_ID=
# AUTO_ROLE_ID=
# CHAT_XP_MIN=15
# CHAT_XP_MAX=25
# VOICE_XP_MIN=3
# VOICE_XP_MAX=5
# LEVEL_UP_NOTIFY=false
# LEVEL_UP_NOTIFY_INTERVAL=5
# LEVEL_UP_CHANNEL_ID=
# AFK_NOTIFY=false
# AFK_AUTOREPLY=true
# AFK_CHANNEL_ID=
# BIRTHDAY_NOTIFY=false
# BIRTHDAY_CHANNEL_ID=
# BIRTHDAY_PING_EVERYONE=false
# BIRTHDAY_PING_HERE=false
# BIRTHDAY_PING_ROLE=
# BIRTHDAY_PING_USER=false
# BIRTHDAY_ROLE=